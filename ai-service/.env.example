# AI verification service — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`.

# Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Model name. Vision-capable Claude model.
# config.py의 기본값과 같다 — 다른 모델로 바꿀 때만 주석을 풀어라. 여기 값이
# config.py 기본값과 다른 값으로 남으면 둘 중 뭐가 진실인지 헷갈린다.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Service port
PORT=8000

# 판정 한 건이 낼 수 있는 출력 상한. 기본 512로 충분하지만 기준·reason을
# 길게 튜닝하면 여기가 먼저 막힌다.
# ANTHROPIC_MAX_TOKENS=512

# Anthropic 호출 타임아웃(초). backend AiVerificationClient가 30초에 끊으므로
# 안쪽인 여기가 먼저 끊어져야 502 사유가 남는다 — 30에 맞추거나 넘기지 마라.
# ANTHROPIC_TIMEOUT_SECONDS=25.0

# 판정 정책 파일(verification.yaml)이 놓인 디렉터리. 기본은 ai-service/prompts.
# 운영에서 이 경로에 볼륨을 마운트하면 이미지 재빌드 없이 판정 기준만 갈아끼울 수 있다.
# POLICY_DIR=/path/to/policies

# 업로드 이미지 크기 상한(MB). 바꾸면 413 에러 메시지도 같이 바뀐다.
# MAX_IMAGE_MB=10
